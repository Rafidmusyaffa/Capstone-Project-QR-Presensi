# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Di Render, isi variabel yang sama lewat menu Environment.

# Port HTTP server (Render mengisi PORT otomatis)
PORT=3000

# WAJIB di produksi: string acak panjang untuk menandatangani token login (JWT).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Jika kosong, server membuat secret acak sehingga semua pengguna logout setiap restart.
JWT_SECRET=

# production = aktifkan HSTS dan peringatan konfigurasi
NODE_ENV=development

# Lokasi file database SQLite (default: server/presensi.db)
# DB_PATH=./server/presensi.db

# Zona waktu acuan presensi (semua aturan waktu memakai jam server di zona ini)
APP_TIMEZONE=Asia/Jakarta

# Isi data demo saat database kosong. false = tanpa data demo
SEED_DEMO=true

# Sumber data demo. Default: server/seed-data.json jika ada, selain itu seed bawaan.
# builtin = selalu pakai seed bawaan di server/db.js (dipakai npm test)
# SEED_SOURCE=builtin

# Daftar origin yang diizinkan CORS, dipisah koma. Kosongkan jika frontend & API satu domain
# CORS_ORIGIN=https://contoh-frontend.example.com

# HANYA untuk pengujian: izinkan simulated_now/simulated_time pada request scan.
# Jangan aktifkan di produksi karena waktu presensi bisa dimanipulasi dari klien.
ALLOW_SIMULATED_TIME=false
