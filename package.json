{
  "name": "presensi-qr",
  "version": "1.0.0",
  "description": "Sistem Informasi Presensi Mahasiswa Berbasis QR Code dengan Manajemen Sesi dan Waktu Presensi",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "postinstall": "npm --prefix client install && npm --prefix client run build",
    "test": "node test-capstone.js"
  },
  "keywords": [
    "attendance",
    "qr-code",
    "capstone",
    "time-based-rules"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
